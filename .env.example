# PLC Agent Configuration
# Copy this file to .env and fill in your values

# LLM API Gateway (OpenAI-compatible endpoint)
OPENAI_API_BASE=https://your-api-gateway.example.com
OPENAI_API_KEY=your-api-key-here

# Model to use (adjust based on your platform's available models)
# Examples: gpt-4o, gpt-4-turbo, claude-3-opus, etc.
MODEL_NAME=gpt-4o

# Knowledge base path (relative to project root)
KNOWLEDGE_BASE_PATH=plc_knowledge_out

# Server settings
API_HOST=0.0.0.0
API_PORT=8000
